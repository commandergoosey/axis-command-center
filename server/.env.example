# ── AXIS Command Center — Server environment variables ──────────────────────
# Copy this file to .env for local development. Never commit .env.

# Port the Express server listens on.
# Railway sets this automatically — do not override on Railway.
PORT=3002

# SQLite database path.
# Railway: set this to the mount path of your persistent volume, e.g. /data/axis.db
# Local: leave unset — defaults to server/data/axis.db
# DB_PATH=/data/axis.db

# Comma-separated list of allowed CORS origins (your Vercel frontend URL).
# Leave unset locally — all origins are permitted in development.
# Example: CORS_ORIGIN=https://axis-command-center.vercel.app
# CORS_ORIGIN=

# Anthropic API key — required for the Intelligence panel (AI briefings).
# ANTHROPIC_API_KEY=sk-ant-...

# Set to any non-empty value to signal live (non-demo) mode.
# Controls the demo_mode flag in /api/config.
# AXIS_LIVE_MODE=true

# SMTP — used by the reports mailer (optional; reports still generate without it).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=
# SMTP_FROM=AXIS Command Center <noreply@example.com>

# FMS adapter base URLs (optional — only needed when connecting real hauler APIs).
# LOCONAV_API_BASE=https://api.loconav.com/v1
# GEOTAB_API_BASE=https://my.geotab.com/apiv1

# App URL — base URL used in password-reset and invite email links.  (LP-5)
# APP_URL=https://axis-command.vercel.app

# Webhook HMAC signing secret — default key for signature verification.   (LP-7)
# Per-hauler secrets (set via admin API) take precedence over this.
# WEBHOOK_SECRET=change-me-before-production

# Log verbosity: error | warn | info | http | debug                        (LP-8)
# Defaults to "http" in development, "info" in production.
# LOG_LEVEL=info

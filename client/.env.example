# ── AXIS Command Center — Client environment variables ──────────────────────
# Vite exposes only variables prefixed with VITE_ to the browser bundle.
# Copy this file to .env.local for local development.

# Backend API origin. Leave empty in development — the Vite dev proxy
# forwards /api/* to localhost:3002 automatically.
# In production (Vercel), set this to your Railway server URL:
#   VITE_API_URL=https://axis-server.up.railway.app
VITE_API_URL=
